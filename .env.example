# ─── Application Config ───
PORT=8000
ENVIRONMENT=development

# ─── Security ───
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:8000,http://10.71.14.1:8000

# ─── Database ───
MONGODB_URI=mongodb://127.0.0.1:27017/claimsupport

# ─── AI APIs ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── AI Models ───
AI_MODEL=models/gemini-flash-lite-latest
AI_VISION_MODEL=models/gemini-flash-lite-latest

# ─── Logging ───
LOG_LEVEL=DEBUG

# ─── Storage ───
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
