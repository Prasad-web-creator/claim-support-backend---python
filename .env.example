# Create .env from this example. Enter credentials directly in the backend environment.
PORT=8000
ENVIRONMENT=development
SUPPORT_EMAIL=
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=365
ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=
OTP_SEND_RATE_LIMIT=5/minute
OTP_VERIFY_RATE_LIMIT=10/minute
AUTH_REQUEST_TIMEOUT_SECONDS=10
EMAIL_OTP_PROVIDER=disabled
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
OTP_EMAIL_SUBJECT="Your {app} verification code"
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_FROM_NAME="Policy Pal"
SMTP_TIMEOUT_SECONDS=15
MONGODB_URI=mongodb://127.0.0.1:27017/claimsupport_development
MONGODB_DATABASE=
# Gemini powers structured extraction and coverage analysis. Set the key on the backend.
GEMINI_API_KEY=
REQUIRE_ANALYSIS_CONSENT=true
ANALYSIS_AGREEMENT_VERSION=1
ANALYSIS_JOB_EXPIRY_HOURS=72
AI_MODEL=models/gemini-flash-lite-latest
# Includes the initial LLM request (3 attempts means up to 2 retries).
AI_MAX_ATTEMPTS=3
AI_MAX_CONCURRENT_REQUESTS=3
MAX_POLICIES_PER_ANALYSIS=3
MULTI_POLICY_MAX_CONCURRENCY=2
LOG_LEVEL=INFO
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ERROR_SAMPLE_RATE=1
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document
PDF_COMPRESSION_ENABLED=true
PDF_COMPRESSION_DPI=150
PDF_GRAYSCALE_ENABLED=true
PDF_COMPRESSION_JPEG_QUALITY=85
PDF_COMPRESSION_MAX_PAGE_PIXELS=10000000
PDF_COMPRESSION_MAX_PAGES=100
FILE_DEDUPLICATION_ENABLED=true
ORPHAN_CLEANUP_ENABLED=true
DOCUMENT_RETENTION_DAYS=0
ORPHAN_CLEANUP_INTERVAL_HOURS=24
ORPHAN_CLEANUP_GRACE_HOURS=24
MAINTENANCE_CHECK_INTERVAL_MINUTES=15
STORAGE_MONITOR_ENABLED=true
STORAGE_MONITOR_INTERVAL_HOURS=24
STORAGE_CAPACITY_BYTES=536870912
STORAGE_WARNING_THRESHOLD_PERCENT=80
STORAGE_CRITICAL_THRESHOLD_PERCENT=90
DATA_CLEANUP_DRY_RUN=false
DATA_CLEANUP_MAX_PERCENTAGE=0.05
DATA_CLEANUP_MAX_COUNT=10000
OCR_DPI=150
OCR_LANGUAGE=eng
OCR_PREPROCESS_ENABLED=true
OCR_DESKEW_ENABLED=true
OCR_THRESHOLD_ENABLED=false
OCR_MIN_CONFIDENCE=50
OCR_TIMEOUT_SECONDS=90
OCR_QUEUE_TIMEOUT_SECONDS=15
OCR_MAX_SCANNED_PAGES=0
OCR_MAX_IMAGE_PIXELS=8000000
TESSERACT_CMD=tesseract
TESSDATA_PREFIX=
